# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- LLM Enrichment (app/) ----
# OpenAI-compatible endpoint for event enrichment. Defaults to Hugging Face router.
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-3-4b-it
LLM_TIMEOUT_SECONDS=15
# CV -> backend authenticated event boundary
EVENT_INGEST_URL=http://127.0.0.1:8000/api/v1/events/ingest
# Required: provision the same secret to the CV producer and backend at runtime.
EVENT_INGEST_TOKEN=
EVENT_INGEST_TIMEOUT_SECONDS=5
EVENT_INGEST_MAX_ATTEMPTS=3
# Optional CV configuration and DEIMv2 asset mounts
CONFIG_DIR=configs
ARTIFACT_DIR=artifacts
# DEIMV2_SOURCE_PATH=third_party/deimv2
# DEIMV2_CONFIG_PATH=configs/deimv2-phase7a-runtime.yaml
# DEIMV2_CHECKPOINT_PATH=artifacts/phase7a-results/outputs/phase7a_deimv2_s_person_luggage/best.pth
# Must equal DINOv3STAs.weights_path inside DEIMV2_CONFIG_PATH; override both together.
# DEIMV2_BACKBONE_PATH=third_party/deimv2/ckpts/vitt_distill.pt
