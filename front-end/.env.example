# Cấu hình frontend — copy thành .env rồi chỉnh theo môi trường của bạn.
# KHÔNG commit file .env.

# Địa chỉ backend FastAPI — đây là địa chỉ TRÌNH DUYỆT gọi tới, không phải
# hostname nội bộ của docker network. Chạy compose trên máy local thì vẫn là
# localhost:8000 vì backend đã publish cổng 8000 ra ngoài.
VITE_API_BASE_URL=http://localhost:8000

# Bỏ trống để suy ra từ VITE_API_BASE_URL (http→ws). Chỉ đặt khi WS khác host.
# VITE_WS_URL=ws://localhost:8000/ws/alerts

# true = chạy toàn bộ UI trên dữ liệu giả lập, không cần backend.
# Dùng khi phát triển frontend song song lúc API chưa xong.
VITE_USE_MOCK=false
